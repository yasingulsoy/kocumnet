# Check-up backend ortam değişkenleri. Yerelde .env olarak kopyalayın.
# Üretimde değerler Dokploy'da (Project Environment) tutulur; backend'e alan adı verilmez.

# PostgreSQL bağlantısı (yerelde checkup_dev, üretimde ayrı bir veritabanı)
DATABASE_URL="postgresql://KULLANICI:PAROLA@localhost:5432/checkup_dev?schema=public"
# İsteğe bağlı: bağlantı havuzu (varsayılan 10, en fazla 100)
DATABASE_POOL_MAX=

# Testler bu sunucuda geçici checkup_test_<rastgele> veritabanı açıp siler (veritabanı adı YAZILMAZ)
TEST_DATABASE_BASE_URL="postgresql://KULLANICI:PAROLA@localhost:5432"

PORT=4000

# Next uygulamalarının (frontend, admin) her istekte x-servis-anahtari ile gönderdiği anahtar; en az 32 karakter
SERVIS_ANAHTARI=

# Parola sıfırlama bağlantısı: ${FRONTEND_URL}/parola-sifirla/<jeton>
FRONTEND_URL=http://localhost:3200

# smtp://kullanici:parola@sunucu:587 ya da smtps://…:465. Geliştirmede log://console (üretimde reddedilir)
SMTP_URL=log://console
MAIL_FROM="Koçum.Net Check-up <noreply@kocum.net>"

# Hiç yönetici yoksa açılışta bu bilgilerle bir YONETICI oluşturulur (yönetici varsa bakılmaz)
ILK_YONETICI_EPOSTA=
ILK_YONETICI_PAROLA=
ILK_YONETICI_AD=

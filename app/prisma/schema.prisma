// Koçum.Net — Matematik Check-up
// Kararların gerekçeleri PLAN.md'de. Buradaki yorumlar sadece "neden böyle" notları.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Ortak enum'lar
// ─────────────────────────────────────────────────────────────

/// Matematik bölümü olan sınavlar.
///
/// ⚠️ KONU AĞACI SINAV BAŞINA ÇOĞALTILMAZ. KPSS, DGS ve ALES matematiği
/// TYT ile büyük ölçüde aynı konulardan oluşuyor; konuyu her sınav için
/// ayrı kaydetmek (a) öğrencinin konu geçmişini sınav değiştirince sıfırlar,
/// (b) soru havuzunu beşe böler. Bunun yerine bir konu birden çok sınava
/// işaretlenir (Topic.examScopes) ve soru gerekirse sınavla kısıtlanır
/// (Question.examScopes).
enum ExamScope {
  LGS
  TYT
  AYT
  KPSS_LISANS
  KPSS_ONLISANS
  DGS
  ALES
  /// @deprecated Eski "TYT+AYT" değeri. Yeni kayıtlarda kullanılmaz;
  /// eski satırlar okunabilsin diye duruyor.
  BOTH
}

/// Yayın durumu. Soru ve paket aynı yaşam döngüsünü izler:
/// DRAFT (yazılıyor) → REVIEW (kontrolde) → PUBLISHED (öğrenciye çıkar) → ARCHIVED.
/// ARCHIVED olan soru yeni oturumlara SEÇİLMEZ ama geçmiş oturumlarda durur —
/// silinirse öğrencinin eski sonucu yeniden hesaplanamaz hale gelir.
enum PublishStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum Role {
  STUDENT
  ADMIN
}

enum Grade {
  GRADE_8
  GRADE_9
  GRADE_10
  GRADE_11
  GRADE_12
  /// Üniversite öğrencisi (DGS/ALES adayı) — "11. sınıfta mısın?" diye
  /// sorulan 26 yaşındaki aday, ürünün onu tanımadığını hemen anlıyor.
  UNIVERSITY
  GRADUATE
}

/// Çeldirici hata tipleri. Öğrenci C'yi seçtiğinde *neden* yanlış yaptığını
/// ek soru sormadan bilmek için — teşhis bunun üstüne kurulu (PLAN §3).
enum ErrorType {
  ISLEM_HATASI
  ISARET_HATASI
  TERS_ISLEM
  KAVRAM_YANILGISI
  EKSIK_OKUMA
  BIRIM_HATASI
  YAKLASIK_DEGER
  FORMUL_KARISTIRMA
  DIGER
}

enum SessionStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
  ABANDONED
}

enum TopicLevel {
  STRONG
  MEDIUM
  WEAK
}

// ─────────────────────────────────────────────────────────────
// Konu ağacı
// ─────────────────────────────────────────────────────────────

/// Konu ağacı: "TYT Matematik" → "Problemler" → "Hız-Yol-Zaman".
/// Ölçüm yaprak konularda yapılır, rapor üst konularda toplanır.
model Topic {
  id        String    @id @default(cuid())
  slug      String    @unique
  name      String
  /// Konunun "ana" sınavı — listelerde rozet olarak gösterilir.
  examScope ExamScope @default(TYT)

  /// Bu konunun geçtiği TÜM sınavlar. KPSS/DGS/ALES matematiği TYT ile
  /// büyük ölçüde ortak olduğu için aynı konu birden fazla sınava işaretlenir;
  /// böylece öğrencinin konu geçmişi sınav değiştirince sıfırlanmıyor ve
  /// soru havuzu bölünmüyor.
  examScopes ExamScope[] @default([])

  /// Gerçek sınavda bu konudan ortalama kaç soru çıkıyor: { "TYT": 4 }.
  /// Çalışma sırası bununla belirleniyor — iki konu da %20 ise sınavda
  /// 5 soru getiren önce çalışılır.
  examWeights Json?

  parentId String?
  parent   Topic?  @relation("TopicTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Topic[] @relation("TopicTree")

  /// Sıralama — rapordaki konu sırası müfredat sırasını izlesin diye.
  sortOrder Int @default(0)

  /// Bu konuda zayıf çıkan öğrenciye önerilecek ürünler (frontend lib/products.ts id'leri).
  /// Koda gömülmez: ürün kataloğu değişince migration gerekmesin.
  recommendedProductIds String[] @default([])

  questions      Question[]
  packageTopics  PackageTopic[]
  retestSessions CheckupSession[] @relation("RetestTopic")
  planItems      PlanItem[]
  notebookItems  NotebookItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  objectives Objective[]

  @@index([parentId, sortOrder])
  @@index([examScope])
}

// ─────────────────────────────────────────────────────────────
// Paketler
// ─────────────────────────────────────────────────────────────

/// Paket türü.
/// INTRO: yeni öğrencinin ilk 12 dakikalık "tanışma" testi — boş panoda tek çağrı.
/// RETEST: plandaki kanıt adımı için tek konuluk kısa test; KATALOGDA GÖRÜNMEZ,
///         konu üzerinden başlatılır.
enum PackageKind {
  STANDARD
  INTRO
  RETEST
  /// Seviyeli check-up. Üç aşamanın da bağlandığı tek paket satırı:
  /// erişim hakkı, ad ve ücretlendirme buradan. Aşama süreleri ve soru
  /// sayıları pakette DEĞİL, lib/levels.ts'te — tek doğruluk kaynağı.
  LEVEL
  /// Alıştırma oturumlarının bağlandığı gizli paket, sınav başına bir tane.
  /// Uygulama ilk kullanımda kendisi açar (lib/practice.ts); katalogda
  /// görünmez, panelden düzenlenmez.
  PRACTICE
}

/// Check-up paketi = kapsamı ve soru dağılımı tanımlı bir test.
/// Yeni paket eklemek satır girmektir, kod değişikliği değil (PLAN §2).
model Package {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  summary     String?
  description String?

  kind PackageKind @default(STANDARD)

  examScope       ExamScope     @default(TYT)
  questionCount   Int
  durationMinutes Int
  status          PublishStatus @default(DRAFT)
  sortOrder       Int           @default(0)

  /// Yanlışın doğruyu götürme oranı. KODA GÖMÜLMEZ:
  /// YKS 0.25 (4 yanlış 1 doğru), LGS 0.3333, KPSS 0. Bu oran ürünün öğrenciye
  /// "emin değilsen işaretle" deyip demeyeceğini değiştirir (PLAN §4).
  penaltyRatio Decimal @default(0.25) @db.Decimal(5, 4)

  /// Ücretsiz mi? Varsayılan TRUE, bilinçli: yeni bir paket eklendiğinde
  /// kazara kilitli gelmesindense kazara açık gelmesi yeğdir — ilki öğrenciyi
  /// sessizce kapının dışında bırakır, ikincisi en fazla gelir kaçırır ve
  /// hemen fark edilir.
  isFree Boolean @default(true)

  topics       PackageTopic[]
  sessions     CheckupSession[]
  entitlements Entitlement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}

/// Pakette hangi konudan kaç soru gelecek.
model PackageTopic {
  id        String @id @default(cuid())
  packageId String
  topicId   String

  questionCount Int
  sortOrder     Int @default(0)

  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Restrict)

  @@unique([packageId, topicId])
  @@index([topicId])
}

// ─────────────────────────────────────────────────────────────
// Sorular
// ─────────────────────────────────────────────────────────────

/// Soru gövdesi JSONB blok dizisi (PLAN §3). Formüller LaTeX kaynağı olarak
/// saklanır, görsel olarak değil — KaTeX ile istemcide render edilir.
model Question {
  id      String @id @default(cuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Restrict)

  /// Blok dizisi: { version, blocks: [...] }. Şema doğrulaması lib/question-schema.ts'te.
  stem Json

  /// stem içindeki text düğümlerinin düz metin izdüşümü.
  /// Tam metin arama + admin listelerinde önizleme için.
  stemText String

  /// stemText'in normalize edilmiş özeti. UNIQUE olması bilinçli:
  /// aynı soru iki kez girilirse istatistik bölünür ve öğrenci aynı soruyu
  /// iki kez görür. Sessiz çift kayıt yerine içe aktarmanın patlaması iyidir.
  fingerprint String @unique

  /// Adım adım çözüm (blok dizisi). Faz 2'de gösterilecek, şimdiden saklanır.
  solution Json?

  difficulty        Int @default(3) // 1 kolay … 5 zor
  targetTimeSeconds Int @default(75)

  status  PublishStatus @default(DRAFT)
  /// Cevap anahtarı düzeltilirse artar. SessionItem.questionVersion ile
  /// eşleşmezse o oturum yeniden hesaplanabilir (PLAN §4).
  version Int           @default(1)

  /// Nereden geldi: "2023 TYT / 12" ya da içe aktarma dosyasındaki satır kimliği.
  sourceRef     String?
  importBatchId String?
  importBatch   ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  /// Soru yalnızca bu sınavlarda sorulabilir. BOŞ = konusunun geçtiği her
  /// sınavda sorulabilir. Ortak konularda seviye farkı olduğunda kullanılır:
  /// "Problemler" hem LGS'de hem TYT'de var ama AYT ağırlığındaki bir soru
  /// LGS testine düşmemeli.
  examScopes ExamScope[] @default([])

  /// Hangi kazanımı ölçüyor (seviyeli check-up). Paket testlerinde boş
  /// olabilir — orada ölçüm konu düzeyinde.
  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  /// Seviyeli check-up'ta hangi seviyenin malzemesi. Boş = yalnızca paket
  /// testlerinde kullanılır.
  level QuestionLevel?

  /// Ampirik zorluk kalibrasyonu için — difficulty elle girilir, bunlar ölçülür.
  shownCount   Int @default(0)
  correctCount Int @default(0)

  choices       Choice[]
  items         SessionItem[]
  exposures     QuestionExposure[]
  notebookItems NotebookItem[]

  /// Eski: yönetim bu uygulamanın içindeyken kullanılıyordu. Yeni kayıtlar
  /// aşağıdaki personel damgalarını kullanır.
  createdById String?
  createdBy   User?   @relation("QuestionAuthor", fields: [createdById], references: [id], onDelete: SetNull)

  /// Soruyu yazan / en son düzenleyen yönetim paneli personeli (admin.kocum.net).
  /// Personel bu veritabanında DEĞİL, backend'in `users` tablosunda — bu yüzden
  /// yabancı anahtar değil, "e-posta (#id)" biçiminde bir damga.
  createdByStaff String?
  updatedByStaff String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Soru seçiminin ana sorgusu: konu + yayında + zorluk.
  @@index([topicId, status, difficulty])
  /// Seviyeli seçimin ana sorgusu: kazanım + seviye + yayında.
  @@index([objectiveId, level, status])
  @@index([level, status])
  @@index([status])
  @@index([importBatchId])
}

/// Şıklar JSONB içinde değil ayrı tabloda: şık bazında atomik istatistik,
/// cevap anahtarı şüphesi sorgusu ve hata tipi teşhisi için (PLAN §3).
model Choice {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  label   String // "A".."E"
  content Json // blok dizisi (şıkta da formül/görsel olabilir)

  /// ⚠️ ASLA öğrenciye giden JSON'a girmez. Sunucuda kontrol edilir (PLAN §3).
  isCorrect Boolean @default(false)

  /// Çeldiricinin hangi hatayı yakaladığı. Doğru şıkta null.
  errorType ErrorType?

  /// Kaç kez seçildi — her cevapta atomik artar.
  chosenCount Int @default(0)

  sortOrder Int      @default(0)
  answers   Answer[]

  @@unique([questionId, label])
  @@index([questionId, sortOrder])
}

/// Geometri şekilleri ve grafikler. LaTeX ile çizilmeyen her şey.
model MediaAsset {
  id         String @id @default(cuid())
  storageKey String @unique
  mimeType   String
  width      Int?
  height     Int?
  byteSize   Int?

  /// Görselin BAYTLARI. Dosya sistemi yerine veritabanında, bilinçli:
  ///
  /// 1. Konteyner geçici — yeniden dağıtımda disk siliniyor. Volume bağlamayı
  ///    unutmak tüm şekilleri sessizce yok eder; soru durur, şekli gider.
  /// 2. Yedekten dönüş atomik olur. Görseller diskte olsaydı, veritabanı
  ///    yedeği geri yüklendiğinde referanslar boşa düşebilirdi.
  ///
  /// Ölçek sorun değil: ~1000 görsel × ~40 KB ≈ 40 MB. 500 MB aşılırsa nesne
  /// depolamaya taşınır — `storageKey` zaten bu soyutlamayı sağlıyor.
  data Bytes

  /// Ekran okuyucu için zorunlu — boş bırakılırsa soru erişilemez olur.
  alt String

  uploadedById    String?
  uploadedBy      User?   @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  /// Yükleyen personel damgası — bkz. Question.createdByStaff.
  uploadedByStaff String?

  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Toplu içe aktarma turu. Hata raporu saklanır ki 300 satırlık dosyanın
/// hangi satırı neden atlandı sorusu cevaplanabilsin.
model ImportBatch {
  id       String @id @default(cuid())
  filename String
  format   String // "json" | "xlsx" | "csv"

  status       String @default("PENDING") // PENDING | DONE | FAILED
  totalRows    Int    @default(0)
  createdCount Int    @default(0)
  skippedCount Int    @default(0)
  /// [{ row, reason, detail }]
  errors       Json?

  questions Question[]

  createdById    String?
  createdBy      User?   @relation("ImportAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  /// İçe aktaran personel damgası — bkz. Question.createdByStaff.
  createdByStaff String?

  createdAt   DateTime  @default(now())
  completedAt DateTime?
}

// ─────────────────────────────────────────────────────────────
// Kullanıcı / oturum
// ─────────────────────────────────────────────────────────────

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  role         Role   @default(STUDENT)

  grade      Grade?
  targetExam ExamScope?
  phone      String?

  /// Hedef net (o sınavın matematik soru sayısına göre). Koçun ilk sorduğu
  /// üç şeyden biri: hangi sınav, ne zaman, kaç net.
  targetNet      Decimal?  @db.Decimal(5, 2)
  targetExamYear Int?
  /// Haftada kaç check-up hedefliyor — plan bunun üstüne kuruluyor.
  weeklyTestGoal Int       @default(1)
  /// Tanışma adımları tamamlandı mı. null = hiç sormadık (sorup geçmekten farklı).
  onboardedAt    DateTime?

  emailVerifiedAt DateTime?
  lastLoginAt     DateTime?

  /// Haftalık koçluk postasını (pazartesi planı) kapattı mı. Hizmet
  /// postaları (parola, kayıt) bundan etkilenmez.
  mailOptOut   Boolean   @default(false)
  /// Postadaki "aboneliği kapat" bağlantısının anahtarı. Giriş gerektirmez;
  /// tahmin edilemez (UUID). Veritabanı üretir ki eski kayıtlar da dolu olsun.
  mailToken    String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Son haftalık posta ne zaman gitti — cron aynı haftada ikinci kez yollamasın.
  lastDigestAt DateTime?

  authSessions        AuthSession[]
  resetTokens         PasswordResetToken[]
  checkupSessions     CheckupSession[]
  exposures           QuestionExposure[]
  authoredQuestions   Question[]           @relation("QuestionAuthor")
  uploadedMedia       MediaAsset[]         @relation("MediaUploader")
  entitlements        Entitlement[]
  grantedEntitlements Entitlement[]        @relation("EntitlementGranter")
  importBatches       ImportBatch[]        @relation("ImportAuthor")
  studyPlans          StudyPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  levelRuns     LevelRun[]
  notebookItems NotebookItem[]

  @@index([role])
}

/// Parola sıfırlama jetonu.
///
/// Oturum jetonu gibi HASH'i saklanıyor — veritabanı sızarsa kimsenin parolası
/// sıfırlanamasın diye. Tek kullanımlık (`usedAt`) ve kısa ömürlü: sıfırlama
/// bağlantısı e-posta kutusunda kalıcı bir arka kapı olmamalı.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Giriş oturumu. Token'ın kendisi DEĞİL hash'i saklanır — veritabanı
/// sızarsa çerezler taklit edilemesin diye.
model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Bir öğrencinin bir pakete (veya tümüne) erişim hakkı.
///
/// TEK MODEL, İKİ SATIŞ BİÇİMİ:
///   tek seferlik alım → packageId dolu, expiresAt null  (o paket, süresiz)
///   abonelik          → packageId null,  expiresAt dolu (tüm paketler, süreli)
///
/// Böylece "tek seferlik mi abonelik mi" kararı beklenirken de şema
/// yazılabiliyor; karar geldiğinde veri göçü gerekmiyor.
model Entitlement {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// null = TÜM paketler.
  packageId String?
  package   Package? @relation(fields: [packageId], references: [id], onDelete: Cascade)

  /// null = süresiz.
  expiresAt DateTime?

  /// Nereden geldi: "manual" (yönetici verdi), "purchase:<ödeme id>", "promo:<kod>".
  /// Ödeme sağlayıcı bağlandığında buraya işlenecek.
  source String  @default("manual")
  note   String?

  /// İptal/iade. Satır SİLİNMEZ — hangi hakkın ne zaman geri alındığı
  /// uyuşmazlıkta kanıt olur.
  revokedAt DateTime?

  grantedById String?
  grantedBy   User?   @relation("EntitlementGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  /// Hakkı veren / geri alan personel damgası (bkz. Question.createdByStaff).
  /// Uyuşmazlıkta "bu hakkı kim, ne zaman verdi/aldı" sorusunun cevabı.
  grantedByStaff String?
  revokedByStaff String?

  createdAt DateTime @default(now())

  @@index([userId, packageId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────
// Check-up oturumu
// ─────────────────────────────────────────────────────────────

/// Test türü. Paket = kataloğdan seçilen tam check-up.
/// Konu tekrar testi = planın "kanıt" adımı: tek konudan 5 soru.
enum SessionKind {
  PACKAGE
  TOPIC_RETEST
  /// Seviyeli check-up'ın bir aşaması (lib/levels.ts).
  LEVEL_STAGE
  /// Alıştırma: süre tutulmaz, her cevaptan hemen sonra doğrusu, hata tipi
  /// ve çözüm gösterilir. ÖLÇÜM DEĞİL: sonuç (CheckupResult) üretmez;
  /// gelişime, eğilime, plana, haftalık postaya, risk listelerine, madde
  /// analizine ve soru/şık sayaçlarına girmez (lib/practice.ts).
  PRACTICE
}

/// Alıştırma hangi yoldan açıldı — ekrandaki başlık ve dönüş yolu buna göre.
enum PracticeMode {
  /// "Benzerini çöz": sonuç ekranındaki bir yanlışın benzeri.
  SIMILAR
  /// "Bu konuda çalış": tek konudan birkaç soru.
  TOPIC
  /// "Bugünkü tekrar": yanlış defterinde vadesi gelen maddelerin benzerleri.
  /// Cevaplar defteri ilerletir (NotebookItem).
  REVIEW
}

/// Soru hangi seviyede sorulabilir (seviyeli check-up).
enum QuestionLevel {
  /// Tek kazanım, temel kural/işlem. Seviye 1'in malzemesi.
  L1_TEMEL
  /// İki konu birleşik ya da çok adımlı. Seviye 2.
  L2_ORTA
  /// Sınav standardı, analiz-yorum. Seviye 3.
  L3_ANALIZ
}

/// Bir aşama ana tur mu, telafi turu mu.
enum StageKind {
  MAIN
  REMEDIAL
}

enum LevelRunStatus {
  IN_PROGRESS
  /// Üç seviye de tamamlandı.
  COMPLETED
  /// Bir kapıda durdu; stoppedAtLevel hangi seviyede olduğunu söyler.
  STOPPED
}

/// Bir öğrencinin bir check-up denemesi.
model CheckupSession {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId String
  package   Package @relation(fields: [packageId], references: [id], onDelete: Restrict)

  kind SessionKind @default(PACKAGE)

  /// TOPIC_RETEST ise hangi konu ölçülüyor; alıştırmada çalışılan konu.
  focusTopicId String?
  focusTopic   Topic?  @relation("RetestTopic", fields: [focusTopicId], references: [id], onDelete: Restrict)

  /// PRACTICE ise hangi yoldan açıldı.
  practiceMode    PracticeMode?
  /// Alıştırma hangi sonuçtan açıldı ("sonuca dön" ve benzer seçimi için).
  /// StudyPlan.sourceSessionId gibi düz alan: kaynak silinse de alıştırma kalsın.
  sourceSessionId String?

  /// LEVEL_STAGE ise hangi denemenin hangi aşaması.
  /// Aşamalar BİLEREK ayrı oturum: her birinin kendi süresi var ve öğrenci
  /// aralarında ara verebiliyor. Böylece mevcut oturum makinesi (soru
  /// sabitleme, sayaç, cevap kaydı, sızıntı koruması) olduğu gibi çalışıyor.
  levelRunId String?
  levelRun   LevelRun?  @relation(fields: [levelRunId], references: [id], onDelete: Cascade)
  stageLevel Int?
  stageKind  StageKind?

  /// Havuz dar olduğu için tekrar gösterilmek zorunda kalınan soru sayısı.
  /// Hesaplanıyordu ama atılıyordu; "bu paketi tekrar çözmeni öneririm"
  /// tavsiyesinin dürüst olabilmesi için saklanıyor.
  relaxedExposureCount Int @default(0)

  status SessionStatus @default(IN_PROGRESS)

  /// Paket ayarlarının oturum başındaki kopyası. Admin test ortasında paketi
  /// düzenlerse puanlama değişmesin diye — questionVersion ile aynı mantık.
  durationMinutes Int
  penaltyRatio    Decimal @db.Decimal(5, 4)

  startedAt   DateTime  @default(now())
  expiresAt   DateTime
  submittedAt DateTime?

  items  SessionItem[]
  result CheckupResult?

  @@index([userId, startedAt])
  @@index([status, expiresAt])
  /// "Bu öğrencinin açık testi var mı?" — panoda, katalogda ve test
  /// başlatmada çalışan en sık sorgu.
  @@index([userId, status, expiresAt])
  @@index([packageId])
  @@index([focusTopicId])
  @@index([levelRunId, stageLevel])
  /// Haftalık test sayımı ve plan üretimi: kullanıcı + durum + tarih.
  @@index([userId, status, submittedAt])
}

/// Oturuma seçilen soru + sıra. Cevaptan ayrı tablo: soru listesi oturum
/// başında sabitlenir, cevap sonra gelir.
model SessionItem {
  id        String         @id @default(cuid())
  sessionId String
  session   CheckupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  sortOrder       Int
  /// Sorunun oturum anındaki sürümü (PLAN §4).
  questionVersion Int

  /// Alıştırmada: bu soru hangi sorunun benzeri (öğrencinin yanlış yaptığı
  /// asıl soru). Sınav oturumlarında boş.
  sourceQuestionId String?

  answer Answer?

  @@unique([sessionId, questionId])
  @@unique([sessionId, sortOrder])
  @@index([questionId])
}

model Answer {
  id            String      @id @default(cuid())
  sessionItemId String      @unique
  sessionItem   SessionItem @relation(fields: [sessionItemId], references: [id], onDelete: Cascade)

  /// null = boş bırakıldı. Boş, yanlıştan farklıdır: net'e etkisi yok.
  choiceId String?
  choice   Choice? @relation(fields: [choiceId], references: [id], onDelete: Restrict)

  /// Sunucuda hesaplanır. null sadece boş cevapta.
  isCorrect Boolean?

  timeSpentMs  Int @default(0)
  /// Kaç kez şık değiştirdi — kararsızlık sinyali.
  changedCount Int @default(0)

  answeredAt DateTime @default(now())

  @@index([choiceId])
}

/// Hesaplanmış sonuç. Türetilebilir ama saklanır: sonuç ekranı ve geçmiş
/// listesi her açılışta 25 satır üzerinden yeniden hesaplanmasın.
model CheckupResult {
  id        String         @id @default(cuid())
  sessionId String         @unique
  session   CheckupSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  correctCount Int
  wrongCount   Int
  blankCount   Int
  netScore     Decimal @db.Decimal(6, 2)
  totalTimeMs  Int

  /// { topics: [{ topicId, name, asked, correct, wrong, blank, ratio, level, avgTimeMs }] }
  topicBreakdown        Json
  /// Zayıf konulardan türeyen ürün önerileri.
  recommendedProductIds String[] @default([])

  /// Oturum anındaki sınav kapsamı. Panodaki toplamlar sınava göre
  /// ayrılabilsin diye burada: LGS, TYT ve KPSS sonuçlarını tek bir
  /// "genel başarı" çizgisinde toplamak anlamsız.
  examScope ExamScope?

  computedAt     DateTime @default(now())
  /// Hangi sürümle hesaplandı — puanlama mantığı değişirse eski sonuçlar ayırt edilsin.
  scoringVersion Int      @default(1)

  @@index([computedAt])
}

// ─────────────────────────────────────────────────────────────
// Haftalık çalışma planı
// ─────────────────────────────────────────────────────────────

/// Kazanım — ölçülebilir en küçük öğrenme hedefi. Konunun altında durur.
///
/// Neden ayrı tablo: seviyeli check-up'ın telafi turu "eksik KAZANIMLARDAN
/// yeni sorular" getiriyor. Konu seviyesinde çalışsaydı "Problemler"de bir
/// soruyu kaçıran öğrenciye problemlerin tamamından soru gelirdi. Kazanım,
/// konudan bir kat daha ince: "Bölme ve Bölünebilme" bir konu, "3 ve 9 ile
/// bölünebilme kuralını uygular" bir kazanım.
model Objective {
  id      String @id @default(cuid())
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  /// İçerik ekibinin kullandığı kalıcı kod — soru dosyalarında bu geçiyor.
  code String @unique
  name String

  /// Hangi sınavlarda ölçülüyor. Boş = konusunun geçtiği her sınavda.
  examScopes ExamScope[] @default([])

  sortOrder Int           @default(0)
  status    PublishStatus @default(DRAFT)

  questions     Question[]
  notebookItems NotebookItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId, sortOrder])
  @@index([status])
}

/// Seviyeli check-up denemesi — üç seviyelik zincirin tamamı.
///
/// Aşamaların kendisi CheckupSession satırları; bu tablo yalnızca zinciri
/// ve kapı kararlarını tutuyor.
model LevelRun {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  examScope ExamScope

  status LevelRunStatus @default(IN_PROGRESS)

  /// Durduysa hangi seviyede (1 ya da 2). Tamamlandıysa null.
  stoppedAtLevel Int?

  /// Öğrencinin ulaştığı en yüksek seviye — raporun başlığı bu.
  reachedLevel Int @default(1)

  /// Şu an hangi seviye oynanabilir. Kapı açıldıkça artar.
  unlockedLevel Int @default(1)

  /// Kapı kararlarının dökümü (lib/levels.ts çıktısı). Karne bunu okuyor.
  gateLog Json?

  /// Telafi turu bekliyorsa hangi kazanımlardan soru gelecek.
  ///
  /// Tur BİLEREK hemen açılmıyor: şema "ekrana uyarı gelir" diyor ve
  /// haklı — öğrenci neden ek soru çözdüğünü bilmeden soruyla
  /// karşılaşmamalı. Ayrıca sayaç, öğrenci "devam" dediğinde başlamalı.
  pendingRemedialIds String[] @default([])

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  stages CheckupSession[]

  @@index([userId, startedAt])
  @@index([status])
  /// aktifKosu(): kullanıcının süren koşusu.
  @@index([userId, status])
}

enum PlanStatus {
  ACTIVE
  COMPLETED
  EXPIRED
}

/// Plandaki iş türü. RETEST'i öğrenci elle işaretleyemez: kapanması için
/// gerçekten testi çözmesi gerekir. 40 soru çözdüğünü söylemek kolay,
/// 5 soruluk kontrol testini geçmek değil.
enum PlanItemKind {
  STUDY
  SOLVE
  REVIEW
  RETEST
}

/// Bir haftalık çalışma planı. Koçun asıl işi bu: ölç → ata → doğrula → ayarla.
model StudyPlan {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  examScope ExamScope
  /// Pazartesi 00:00 (Europe/Istanbul). Hafta sınırı sunucunun UTC'sine göre
  /// hesaplanırsa öğrenci pazar gecesi planını kaybeder.
  weekStart DateTime   @db.Date
  status    PlanStatus @default(ACTIVE)

  /// Plan hangi sonuçtan türedi — "neden bu plan?" sorusunun cevabı.
  sourceSessionId String?

  /// Koçun o haftaki tek cümlesi.
  coachNote String?

  items PlanItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([userId, weekStart])
}

model PlanItem {
  id      String    @id @default(cuid())
  planId  String
  plan    StudyPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  topicId String?
  topic   Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)

  kind  PlanItemKind
  title String

  targetQuestionCount Int?
  estimatedMinutes    Int
  sortOrder           Int  @default(0)

  /// Önerilen yayın (lib/products.ts kimliği).
  productId String?

  /// Öğrenci işaretledi.
  doneAt DateTime?

  /// RETEST için: bunu öğrenci değil SİSTEM doldurur.
  verifiedBySessionId String?

  /// Geçen haftadan devredildiyse hangi işten geldi — "bunu ikinci kez
  /// erteliyorsun" diyebilmek için.
  carriedFrom String?

  @@index([planId, sortOrder])
  @@index([topicId])
}

/// Son gösterim kaydı. Aynı öğrenciye aynı soruyu 30 gün içinde tekrar
/// göstermemek için (PLAN §5). Oturum başına satır değil, çift başına tek satır —
/// tablo şişmesin.
model QuestionExposure {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  lastShownAt DateTime @default(now())
  showCount   Int      @default(1)

  @@unique([userId, questionId])
  @@index([userId, lastShownAt])
}

// ─────────────────────────────────────────────────────────────
// Yanlış defteri
// ─────────────────────────────────────────────────────────────

/// Yanlış defteri maddesi: öğrencinin bir ÖLÇÜMDE (paket, kontrol testi,
/// seviyeli aşama) yanlış yaptığı ya da boş bıraktığı soru.
///
/// Aralıklı tekrarla geri gelir ve her tekrarda bu sorunun BENZERİ sorulur,
/// kendisi değil (çözümünü sonuç ekranında gördü). Kurallar ve aralıklar
/// lib/review.ts'te, veritabanı tarafı lib/notebook.ts'te. Alıştırma cevabı
/// madde AÇMAZ; maddeyi yalnızca "Bugünkü tekrar" ilerletir.
model NotebookItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  /// Sorunun konusu ve kazanımı: gruplamak için kopya, her yeni yanlışta
  /// sorudan tazelenir. Benzer seçimi sorunun GÜNCEL alanlarına bakar.
  topicId     String
  topic       Topic      @relation(fields: [topicId], references: [id], onDelete: Cascade)
  objectiveId String?
  objective   Objective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  /// Sorunun sorulduğu sınav: benzer soru bu sınavın kapsamından seçilir.
  examScope   ExamScope

  /// Kaçıncı tekrarı bekliyor: 0, 1, 2 (lib/review.ts TEKRAR_ARALIKLARI_GUN).
  stage          Int       @default(0)
  /// Tekrar ne zaman gelir (Türkiye saatiyle gün başı).
  dueAt          DateTime
  lastReviewedAt DateTime?
  /// Defterden çıktı: son aşamayı da doğru geçti. Yeni bir yanlışta yeniden açılır.
  resolvedAt     DateTime?

  /// Ölçümlerde kaç kez yanlış/boş (bilgi).
  wrongCount    Int      @default(1)
  /// Maddeyi en son hangi ölçüm yazdı ve o ölçüm ne zaman bitti. Aynı ölçüm
  /// yeniden puanlanırsa ya da daha eski bir ölçüm geç puanlanırsa (cron)
  /// ilerleme sıfırlanmasın diye.
  lastSessionId String
  lastWrongAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Bir öğrencide aynı soru tek madde: yeniden yanlış yapılırsa madde sıfırlanır.
  @@unique([userId, questionId])
  /// Bugünkü tekrar: öğrencinin açık ve vadesi gelmiş maddeleri.
  @@index([userId, resolvedAt, dueAt])
  @@index([questionId])
  @@index([topicId])
  @@index([objectiveId])
}

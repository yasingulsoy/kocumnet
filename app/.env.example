# ─────────────────────────────────────────────────────────────
# Koçum.Net Matematik Check-up — ortam değişkenleri
#
# Bu dosyayı .env olarak kopyalayıp doldurun. .env COMMIT EDİLMEZ.
# ─────────────────────────────────────────────────────────────

# ZORUNLU — PostgreSQL bağlantısı.
# Frontend'in kullandığı `kocumnet` veritabanından AYRI bir veritabanı olmalı.
DATABASE_URL="postgresql://kullanici:parola@host:5432/kocumnet_checkup?schema=public"

# ZORUNLU (üretimde) — parola sıfırlama bağlantılarının tam adresi buradan kurulur.
# Yanlışsa e-postadaki bağlantı localhost'u gösterir.
NEXT_PUBLIC_APP_URL="https://checkup.kocum.net"

# Ürün önerilerinin gittiği pazarlama sitesi.
NEXT_PUBLIC_SITE_URL="https://kocum.net"

# ─── E-posta ──────────────────────────────────────────────────
# Gönderilenler: hoş geldin (kayıt), parola sıfırlama, "parolan değişti".
# SMTP_URL YOKSA parola sıfırlama KAPALIDIR ve kullanıcıya bunu söyleriz;
# sessizce başarısız olmaz. Backend ile aynı hesap kullanılabilir.
#   Resend:  smtps://resend:re_XXXXXXXX@smtp.resend.com:465
#   Geliştirme (gönderme, günlüğe yaz): log://console  (üretimde reddedilir)
SMTP_URL=""
MAIL_FROM="Koçum.Net Check-up <noreply@kocum.net>"
NEXT_PUBLIC_SUPPORT_EMAIL="info@kocum.net"

# ─── Zamanlanmış bakım ────────────────────────────────────────
# /api/cron ucunu koruyan anahtar (en az 32 karakter). Dışarıdan 15 dakikada
# bir çağrılır (Dokploy Schedule / cron):
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://checkup.kocum.net/api/cron
# Yaptıkları: süresi dolan testleri puanlar, eski oturum ve jetonları siler.
# Üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# Yönetim (soru ekleme, öğrenciler, erişim hakları) bu uygulamada DEĞİL:
# admin.kocum.net (kocumnet/admin) aynı veritabanına CHECKUP_DATABASE_URL ile bağlanır.

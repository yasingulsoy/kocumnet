# ─────────────────────────────────────────────────────────────
# Koçum.Net Matematik Check-up — ortam değişkenleri
#
# Bu dosyayı .env olarak kopyalayıp doldurun. .env COMMIT EDİLMEZ.
# ─────────────────────────────────────────────────────────────

# ZORUNLU — PostgreSQL bağlantısı.
# Frontend'in kullandığı `kocumnet` veritabanından AYRI bir veritabanı olmalı.
DATABASE_URL="postgresql://kullanici:parola@host:5432/kocumnet_checkup?schema=public"

# ZORUNLU (üretimde) — parola sıfırlama bağlantılarının tam adresi buradan kurulur.
# Yanlışsa e-postadaki bağlantı localhost'u gösterir.
NEXT_PUBLIC_APP_URL="https://checkup.kocum.net"

# Ürün önerilerinin gittiği pazarlama sitesi.
NEXT_PUBLIC_SITE_URL="https://kocum.net"

# ─── E-posta (parola sıfırlama) ───────────────────────────────
# SMTP_URL YOKSA parola sıfırlama KAPALIDIR ve kullanıcıya bunu söyleriz.
# Sessizce başarısız olmaz. Örnek: smtps://kullanici:parola@smtp.example.com:465
SMTP_URL=""
MAIL_FROM="Koçum.Net Check-up <noreply@kocum.net>"
NEXT_PUBLIC_SUPPORT_EMAIL="info@kocum.net"

# ─── Yönetici hesabı (yalnızca ilk kurulumda) ─────────────────
# `npm run db:seed` bu ikisi DOLUYSA yönetici hesabı açar.
# Bilinen varsayılan parolalı hesap yaratmıyoruz; boş bırakılırsa atlanır.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Yönetici"

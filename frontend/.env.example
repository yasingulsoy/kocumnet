# ─────────────────────────────────────────────────────────────────────────────
# Koçum.Net — Frontend
#
# ⚠️ İKİSİ DE "NEXT_PUBLIC_" ÖNEKLİ → DERLEME (build) ANINDA bundle'a gömülür.
#    Runtime'da set etmek İŞE YARAMAZ. Dokploy'da bunları
#    "Environment → Build Environment Variables" bölümüne ekle.
# ─────────────────────────────────────────────────────────────────────────────

# Sitenin kanonik adresi (sonunda / OLMADAN).
# Kullanıldığı yer: canonical, hreflang, Open Graph, sitemap.xml, llms.txt, JSON-LD.
# Set edilmezse http://localhost:3000'e düşer → Google localhost'u indeksler,
# sitemap ve llms.txt localhost adresleriyle üretilir.
# PROD: https://kocum.net
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Backend API adresi (sonunda / OLMADAN).
# Kullanıldığı yer: blog listesi/detayı, blog görselleri, görüntülenme sayacı,
# next.config.ts'teki image remotePatterns.
# NOT: Görüntülenme sayacı bir CLIENT component — bu yüzden NEXT_PUBLIC_ öneki
#      şart; sunucu tarafı BACKEND_URL takma adı tarayıcıya ulaşmaz.
# PROD: https://api.kocum.net
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:5000

# Matematik check-up uygulamasının adresi (sonunda / OLMADAN).
# Kullanıldığı yer: ana sayfadaki check-up bölümü ve hero düğmesi, üstteki marka
# şeridi, mobil menü ve altbilgi.
# BOŞ BIRAKILIRSA bu bağlantıların HİÇBİRİ ÇIKMAZ — uygulama yayına alınmadan ana sayfada
# 404'e giden bir düğme durmasın diye bilerek böyle.
# PROD: https://checkup.kocum.net  (adres kesinleşince)
NEXT_PUBLIC_CHECKUP_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Site yönetimi (/admin) — SUNUCU tarafı, RUNTIME değişkeni (NEXT_PUBLIC_ değil,
# tarayıcıya inmez). Dokploy'da normal "Environment" bölümüne.
# ─────────────────────────────────────────────────────────────────────────────

# Backend'deki BFF_SHARED_SECRET ile AYNI değer (en az 32 karakter).
# Tanımlıysa /admin, backend'e isteği yapan tarayıcının gerçek IP'sini imzalı
# (HMAC) gönderir; backend giriş denemesi sınırlarını kişi başına uygular.
# Boşsa eski davranış: bütün personel tek (bu sunucunun) IP'siyle sayılır.
# IP, önümüzdeki tek güvenilir vekilin (Dokploy/Traefik) yazdığı x-real-ip'ten,
# yoksa x-forwarded-for'un SON öğesinden okunur.
BFF_SHARED_SECRET=

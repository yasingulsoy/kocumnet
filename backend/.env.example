# ─────────────────────────────────────────────────────────────
# Koçum.Net API — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayıp doldurun. .env COMMIT EDİLMEZ.
# ─────────────────────────────────────────────────────────────

# Geliştirmede "development" yazın. Üretimde "production" yazın.
# ⚠️ Güvenlik kararları (çerez Secure bayrağı, CSRF) yalnızca "development"
# değerini geliştirme sayar; boş bırakmak üretim gibi davranır (kapalı taraf).
NODE_ENV=development
PORT=5000

# ⚠️ ZORUNLU — en az 32 karakter, TAHMİN EDİLEMEZ ve bu dosyada YAZMAYAN bir değer.
# Bu anahtarı bilen herkes kendine yönetici jetonu imzalayabilir.
# Üretimde örnek/zayıf bir değerle sunucu AÇILMAZ (config/env.js).
# Üret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kocumnet
DB_USER=postgres
DB_PASSWORD=

FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
BACKEND_URL=http://127.0.0.1:5000

# ⚠️ ÜRETİMDE ZORUNLU — tarayıcıdan API'ye erişebilecek kökenler (virgülle).
# Tanımlı değilse sunucu üretimde açılmaz; eskiden sessizce localhost'a izin veriyordu.
# CORS_ORIGINS=https://kocum.net,https://www.kocum.net,https://admin.kocum.net

# Panel oturum çerezinin alanı.
# Geliştirmede BOŞ. Üretimde ".kocum.net" olmalı: yönetim panelindeki Check-up
# ekranları oturumu sunucu tarafında doğruluyor (bkz. admin/DEPLOY.md).
AUTH_COOKIE_DOMAIN=

# Yalnızca geliştirmede etkili: CSRF korumasını kapatır. Üretimde yok sayılır.
CSRF_DISABLED=1

# İlk yönetici hesabı (scripts/seed-admin.js). Hesap açıldıktan sonra bu iki
# satırı ortam değişkenlerinden SİLİN.
ADMIN_EMAIL=admin@kocum.net
ADMIN_PASSWORD=

# ─── İletişim formu bildirimleri (isteğe bağlı) ───────────────
# SMTP_URL yoksa mesajlar yalnızca panelde görünür (kaybolmaz), e-posta gitmez.
# Örnek: smtps://kullanici:parola@smtp.example.com:465
SMTP_URL=
MAIL_FROM=Koçum.Net <noreply@kocum.net>
# Yeni mesaj bildirimi kime gitsin (virgülle birden fazla yazılabilir).
CONTACT_NOTIFY_TO=

# ─── Nadiren gerekenler ───────────────────────────────────────
# Tüm SQL sorgularını günlüğe yazar (gürültülü, yalnızca hata ararken).
DB_LOG_ALL_SQL=false
# Açılışta tabloları şemaya göre DEĞİŞTİRİR. Üretimde açmayın.
DB_SYNC_ALTER=false

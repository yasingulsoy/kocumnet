# ─────────────────────────────────────────────────────────────
# Koçum.Net API — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayıp doldurun. .env COMMIT EDİLMEZ.
# ─────────────────────────────────────────────────────────────

# Geliştirmede "development" yazın. Üretimde "production" yazın.
# ⚠️ Güvenlik kararları (çerez Secure bayrağı, CSRF) yalnızca "development"
# değerini geliştirme sayar; boş bırakmak üretim gibi davranır (kapalı taraf).
NODE_ENV=development
PORT=5000

# ⚠️ ZORUNLU — en az 32 karakter, TAHMİN EDİLEMEZ ve bu dosyada YAZMAYAN bir değer.
# Bu anahtarı bilen herkes kendine yönetici jetonu imzalayabilir.
# Üretimde örnek/zayıf bir değerle sunucu AÇILMAZ (config/env.js).
# Üret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

DB_HOST=localhost
DB_PORT=5432
DB_NAME=kocumnet
DB_USER=postgres
DB_PASSWORD=

# Site. Site yönetimi (blog, mesajlar, personel) bu adresin /admin yolunda;
# davet ve parola sıfırlama bağlantıları buradan üretilir.
FRONTEND_URL=http://localhost:3000
# Check-up yönetim paneli (admin.kocum.net) — yalnızca geliştirme CORS listesi için.
ADMIN_URL=http://localhost:3001
BACKEND_URL=http://127.0.0.1:5000

# ⚠️ ÜRETİMDE ZORUNLU — tarayıcıdan API'ye erişebilecek kökenler (virgülle).
# Tanımlı değilse sunucu üretimde açılmaz; eskiden sessizce localhost'a izin veriyordu.
# CORS_ORIGINS=https://kocum.net,https://www.kocum.net,https://admin.kocum.net

# Panel oturum çerezinin alanı.
# Geliştirmede BOŞ. Üretimde ".kocum.net" olmalı: yönetim panelindeki Check-up
# ekranları oturumu sunucu tarafında doğruluyor (bkz. admin/DEPLOY.md).
AUTH_COOKIE_DOMAIN=

# Yalnızca geliştirmede etkili: CSRF korumasını kapatır. Üretimde yok sayılır.
CSRF_DISABLED=1

# ─── Site yönetimi (kocum.net/admin) ──────────────────────────
# ÜRETİMDE ÖNERİLİR. kocum.net/admin bir BFF: personelin bütün istekleri
# frontend SUNUCUSUNUN tek IP'sinden gelir; IP'ye göre sayılan sınırlar
# (giriş denemeleri gibi) herkes için ortak kova olur.
# Bu sır backend'de VE frontend'de AYNI değerle tanımlıysa frontend,
# isteği yapan tarayıcının gerçek IP'sini imzalayıp (HMAC, sır ağda dolaşmaz)
# gönderir; backend imzayı doğrulayıp o IP'yle sayar.
# Boşsa, 32 karakterden kısaysa ya da imza tutmazsa eski davranış.
# İki sunucunun saati 5 dakikadan fazla kaymamalı (imza zaman damgalı).
# Üret:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BFF_SHARED_SECRET=

# İlk yönetici hesabı (scripts/seed-admin.js). Hesap açıldıktan sonra bu iki
# satırı ortam değişkenlerinden SİLİN.
ADMIN_EMAIL=admin@kocum.net
ADMIN_PASSWORD=

# ─── E-posta ──────────────────────────────────────────────────
# Gönderilenler: iletişim formu bildirimi + gönderene otomatik yanıt, personel
# daveti (parola belirleme), parola sıfırlama, "parolan değişti" uyarısı.
#
# SMTP_URL boşsa: mesajlar yine veritabanına düşer ama personel daveti ve
# parola sıfırlama ÇALIŞMAZ (uç nokta dürüstçe 503 döner). Üretimde doldur.
#
# Önerilen: Resend (ücretsiz katman 3.000/ay, tek DNS kaydıyla alan doğrulama)
#   SMTP_URL=smtps://resend:re_XXXXXXXX@smtp.resend.com:465
# Diğer örnekler:
#   smtps://kullanici:parola@smtp.yandex.com:465     (Yandex 360 kurumsal)
#   smtp://kullanici:parola@smtp-relay.brevo.com:587  (Brevo, STARTTLS)
# Parolada özel karakter varsa URL-kodla (@ → %40, : → %3A).
# Geliştirmede gerçek SMTP olmadan davet/sıfırlama akışını denemek için:
#   SMTP_URL=log://console   → posta gönderilmez, sunucu günlüğüne yazılır (üretimde reddedilir)
SMTP_URL=
MAIL_FROM=Koçum.Net <noreply@kocum.net>
# Yeni iletişim mesajı bildirimi kime gitsin (virgülle birden fazla).
CONTACT_NOTIFY_TO=

# ─── Nadiren gerekenler ───────────────────────────────────────
# Tüm SQL sorgularını günlüğe yazar (gürültülü, yalnızca hata ararken).
DB_LOG_ALL_SQL=false
# Açılışta tabloları şemaya göre DEĞİŞTİRİR. Üretimde açmayın.
DB_SYNC_ALTER=false
